# 文件用途：列出本项目支持的环境变量示例，不保存任何真实密钥。
# 调用关系：开发者复制为 .env；model/factory.py 和 web_search.py 通过环境读取这些值。
# 修改易踩坑：只能提交占位符，新增变量要同步 README，聊天与 Embedding 的供应商密钥不能混用。
# DeepSeek 官方 API：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 仅供 text-embedding-v4 建库和查询向量使用，不用于聊天模型。
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：开启 Tavily 可信网页搜索时填写。缺失或请求失败会自动回退本地知识库。
# TAVILY_API_KEY=your_tavily_api_key

# 可选：覆盖短期 Checkpoint、会话历史和长期记忆的 SQLite 文件位置
# EDUCATION_MEMORY_DB_PATH=storage/education_memory.sqlite3

# 可选：临时覆盖 config/knowledge.yml 中的向量后端，可填 sqlite、chroma 或 qdrant
# EDUCATION_VECTOR_BACKEND=sqlite
# 生产服务副本应关闭查询时写索引，只让单独一个索引任务执行 --sync-index。
# EDUCATION_SYNC_ON_SEARCH=false

# 独立 Chroma Server。默认值与 deploy/chroma/docker-compose.yml 一致。
# CHROMA_MODE=http
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database
# 如果前置网关要求 Bearer Token，再配置这一项；不要提交真实 Token。
# CHROMA_AUTH_TOKEN=your_chroma_gateway_token

# 独立 Qdrant Server。默认值与 deploy/qdrant/docker-compose.yml 一致。
# QDRANT_HTTP_PORT 只控制 Compose 发布端口；修改后必须同步修改 QDRANT_URL 的端口。
# QDRANT_HTTP_PORT=6333
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_GRPC_PORT=6334
# QDRANT_PREFER_GRPC=false
# QDRANT_TIMEOUT=10
# 仅当远端 Qdrant 已启用认证时填写；生产必须同时启用 API Key、HTTPS 和私网隔离。
# QDRANT_API_KEY=your_qdrant_api_key
