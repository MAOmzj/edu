# 文件用途：列出本项目支持的环境变量示例，不保存任何真实密钥。
# 调用关系：开发者复制为 .env；model/factory.py、web_search.py 和 rag/vector_store.py 通过环境读取这些值。
# 修改易踩坑：只能提交占位符，新增变量要同步 README，聊天与 Embedding 的供应商密钥不能混用。

# ---------------------------------------------------------------------------
# 默认部署走本机 vLLM（config/model.yml 的 chat_provider/embedding_provider 都是
# local_vllm），聊天与向量都在本机完成，因此下面这些密钥都不是必需的。
# 只有当你要切回云端供应商时，才需要填写对应的 Key。
# ---------------------------------------------------------------------------

# 临时切换供应商，不必修改 config/model.yml。
# EDUCATION_CHAT_PROVIDER=local_vllm        # local_vllm 或 deepseek
# EDUCATION_EMBEDDING_PROVIDER=local_vllm   # local_vllm、dashscope 或 local-hashing-zh-v1

# 本机 vLLM 地址与占位 Key（vLLM 默认不校验鉴权，留空即用内置占位值 EMPTY）。
# LOCAL_VLLM_CHAT_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# LOCAL_VLLM_API_KEY=your_local_vllm_api_key

# 独立摘要模型。开启前先下载模型并运行 python scripts/serve.py summary。
# EDUCATION_SUMMARY_ENABLED=true
# EDUCATION_SUMMARY_BASE_URL=http://127.0.0.1:8002/v1
# EDUCATION_SUMMARY_MODEL_NAME=education-summary
# SUMMARY_GPU_MEM_UTIL=0.15
# SUMMARY_MAX_MODEL_LEN=16384

# 仅在 EDUCATION_CHAT_PROVIDER=deepseek 时需要。
# DeepSeek 官方 API：https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 仅在 EDUCATION_EMBEDDING_PROVIDER=dashscope，或重新开启 Rerank 精排时需要。
# 仅供 text-embedding-v4 建库和查询向量 / 百炼 Rerank 使用，不用于聊天模型。
# DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：开启 Tavily 可信网页搜索时填写。缺失或请求失败会自动回退本地知识库。
# TAVILY_API_KEY=your_tavily_api_key

# 可选：覆盖短期 Checkpoint、会话历史和长期记忆的 SQLite 文件位置
# EDUCATION_MEMORY_DB_PATH=storage/education_memory.sqlite3

# 可选：临时覆盖 config/knowledge.yml 中的向量后端，可填 sqlite、chroma 或 qdrant
# EDUCATION_VECTOR_BACKEND=chroma
# 生产服务副本应关闭查询时写索引，只让单独一个索引任务执行 --sync-index。
# EDUCATION_SYNC_ON_SEARCH=false

# 独立 Chroma Server。本机部署默认使用内嵌 persistent 模式（无需服务），
# 只有连独立服务时才需要把 CHROMA_MODE 改成 http 并配置下面这些项。
# CHROMA_MODE=persistent
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database
# 如果前置网关要求 Bearer Token，再配置这一项；不要提交真实 Token。
# CHROMA_AUTH_TOKEN=your_chroma_gateway_token

# 独立 Qdrant Server（本机没有 Docker，默认不使用）。
# QDRANT_HTTP_PORT 只控制 Compose 发布端口；修改后必须同步修改 QDRANT_URL 的端口。
# QDRANT_HTTP_PORT=6333
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_GRPC_PORT=6334
# QDRANT_PREFER_GRPC=false
# QDRANT_TIMEOUT=10
# 仅当远端 Qdrant 已启用认证时填写；生产必须同时启用 API Key、HTTPS 和私网隔离。
# QDRANT_API_KEY=your_qdrant_api_key
